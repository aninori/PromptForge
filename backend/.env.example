# Copy to .env and adjust. NEVER commit a filled-in .env — GROQ_API_KEY is a
# real secret.
#
# Note: nothing loads .env automatically (no python-dotenv in the dependency
# set). These are plain environment variables — export them in your shell, or
# set them in whatever launches uvicorn.

# Provider: ollama (local, default) or groq
CF_PROVIDER=ollama

# Models. small_model runs the complexity + request-type classifiers and query
# optimization; guard_model runs the intent guard alone — its mistakes are
# user-visible and blocking (a false "off_topic" refuses a real question), so it
# gets a larger model. gen/large handle generation.
CF_GEN_MODEL=deepseek-coder-v2:16b
CF_SMALL_MODEL=llama3.2:3b
CF_GUARD_MODEL=qwen2.5-coder:7b
CF_LARGE_MODEL=deepseek-coder-v2:16b
CF_EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434

# Context window asked of Ollama. MUST exceed CF_TOKEN_BUDGET with room for the
# reply: Ollama defaults to 4096 regardless of what the model supports, and a
# larger prompt comes back as a bare 400.
CF_NUM_CTX=16384

# Retrieval
CF_TOP_K=8
CF_TOKEN_BUDGET=12000
CF_USE_EXPANSION=true
CF_RERANK_WEIGHT=0.5
CF_MAX_DOC_CHUNKS=2

# Indexing. Ollama serializes embed work per model, so high concurrency only
# deepens its queue until requests time out. Keep at or below your core count.
CF_EMBED_CONCURRENCY=4
CF_EMBED_TIMEOUT=300

# Dashboard cost estimate (USD per million tokens) and the label shown with it.
CF_PRICE_PER_MTOK=3.00
CF_PRICE_BASIS=Claude Sonnet 5 input rates

# Optional: Groq cloud fallback. Leave blank unless CF_PROVIDER=groq.
GROQ_API_KEY=
CF_GROQ_MODEL=qwen/qwen3-32b
