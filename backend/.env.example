# Provider: ollama (local, default) or groq
CF_PROVIDER=ollama
CF_GEN_MODEL=mistral:7b
CF_EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434

# Retrieval
CF_TOP_K=4
CF_TOKEN_BUDGET=6000
CF_USE_EXPANSION=true

# Optional: Groq cloud fallback
GROQ_API_KEY=
CF_GROQ_MODEL=llama-3.1-8b-instant
